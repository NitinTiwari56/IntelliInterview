{
  "info": {
    "name": "Interview IQ - Coding (via gateway 8080)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"gw-test@example.com\",\n  \"password\": \"Strong@123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Health (expect 200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/coding/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "coding",
            "health"
          ]
        }
      }
    },
    {
      "name": "3. Languages (starterCode milega)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/coding/languages",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "coding",
            "languages"
          ]
        }
      }
    },
    {
      "name": "4. Problem list (7 seeded, status TODO)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/coding/problems",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "coding",
            "problems"
          ]
        }
      }
    },
    {
      "name": "4b. Filter EASY",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/coding/problems?difficulty=EASY",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "coding",
            "problems?difficulty=EASY"
          ]
        }
      }
    },
    {
      "name": "5. Problem detail (sirf sample cases dikhte hain)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/coding/problems/sum-of-two-numbers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "coding",
            "problems",
            "sum-of-two-numbers"
          ]
        }
      }
    },
    {
      "name": "6. RUN correct python (expect ACCEPTED, 2 PASSED) - 5 sec wait karke",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/coding/problems/sum-of-two-numbers/run",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "coding",
            "problems",
            "sum-of-two-numbers",
            "run"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"language\": \"python\",\n  \"sourceCode\": \"a, b = map(int, input().split())\\nprint(a + b)\"\n}"
        }
      }
    },
    {
      "name": "7. RUN custom input (expect COMPLETED, output 30)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/coding/problems/sum-of-two-numbers/run",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "coding",
            "problems",
            "sum-of-two-numbers",
            "run"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"language\": \"python\",\n  \"sourceCode\": \"a, b = map(int, input().split())\\nprint(a + b)\",\n  \"customInput\": \"10 20\\n\"\n}"
        }
      }
    },
    {
      "name": "8. SUBMIT wrong (expect WRONG_ANSWER, failedCase)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/coding/problems/sum-of-two-numbers/submit",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "coding",
            "problems",
            "sum-of-two-numbers",
            "submit"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"language\": \"python\",\n  \"sourceCode\": \"print(0)\"\n}"
        }
      }
    },
    {
      "name": "9. SUBMIT correct (expect ACCEPTED 4/4)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/coding/problems/sum-of-two-numbers/submit",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "coding",
            "problems",
            "sum-of-two-numbers",
            "submit"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"language\": \"python\",\n  \"sourceCode\": \"a, b = map(int, input().split())\\nprint(a + b)\"\n}"
        }

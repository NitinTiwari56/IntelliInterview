          ]
        }
      }
    },
    {
      "name": "ADMIN (token ADMIN role ka chahiye)",
      "item": [
        {
          "name": "A1. Admin list",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/coding/admin/problems",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "coding",
                "admin",
                "problems"
              ]
            }
          }
        },
        {
          "name": "A2. Bulk import (docs/problems template)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/coding/admin/problems/import",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "coding",
                "admin",
                "problems",
                "import"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"problems\": [\n    {\n      \"slug\": \"count-vowels\",\n      \"title\": \"Count Vowels\",\n      \"description\": \"Ek string me kitne vowels (a, e, i, o, u) hain, ginke print karo.\\n\\n**Input:** Ek line mein lowercase letters aur spaces wali string.\\n\\n**Output:** Vowels ki ginti.\\n\\n**Constraints:** 1 <= length <= 1000\\n\\n**Example**\\n```\\nInput:  hello world\\nOutput: 3\\n```\",\n      \"difficulty\": \"EASY\",\n      \"topic\": \"Strings\",\n      \"published\": true,\n      \"testCases\": [\n        {\n          \"input\": \"hello world\\n\",\n          \"expectedOutput\": \"3\\n\",\n          \"sample\": true\n        },\n        {\n          \"input\": \"rhythm\\n\",\n          \"expectedOutput\": \"0\\n\",\n          \"sample\": true\n        },\n        {\n          \"input\": \"aeiou\\n\",\n          \"expectedOutput\": \"5\\n\",\n          \"sample\": false\n        },\n        {\n          \"input\": \"interview iq\\n\",\n          \"expectedOutput\": \"5\\n\",\n          \"sample\": false\n        }\n      ]\n    },\n    {\n      \"slug\": \"second-largest\",\n      \"title\": \"Second Largest Element\",\n      \"description\": \"Array ka doosra sabse bada DISTINCT element print karo.\\n\\n**Input:**\\n- Pehli line: `n`\\n- Doosri line: `n` integers\\n\\n**Output:** Doosra sabse bada alag (distinct) value. Kam se kam do alag values guaranteed hain.\\n\\n**Constraints:** 2 <= n <= 10^5\\n\\n**Example**\\n```\\nInput:\\n5\\n4 9 9 2 7\\nOutput: 7\\n```\",\n      \"difficulty\": \"MEDIUM\",\n      \"topic\": \"Arrays\",\n      \"published\": true,\n      \"testCases\": [\n        {\n          \"input\": \"5\\n4 9 9 2 7\\n\",\n          \"expectedOutput\": \"7\\n\",\n          \"sample\": true\n        },\n        {\n          \"input\": \"2\\n1 2\\n\",\n          \"expectedOutput\": \"1\\n\",\n          \"sample\": true\n        },\n        {\n          \"input\": \"4\\n-5 -1 -1 -9\\n\",\n          \"expectedOutput\": \"-5\\n\",\n          \"sample\": false\n        },\n        {\n          \"input\": \"4\\n10 10 3 10\\n\",\n          \"expectedOutput\": \"3\\n\",\n          \"sample\": false\n        }\n      ]\n    }\n  ]\n}"
            }
          }
        }
      ]
    }
  ]
}